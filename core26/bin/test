#!/bin/bash

NO_CONFINEMENT=false
REMAINING_ARGS=()
# When invoked directly (bypassing the snap launcher), SNAP is not set.
# Derive it from this script's own location: bin/test lives at $SNAP/bin/test.
SNAP="${SNAP:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")}"

for arg in "$@"; do
    case "$arg" in
        --no-confinement)
            NO_CONFINEMENT=true
            ;;
        *)
            REMAINING_ARGS+=("$arg")
            ;;
    esac
done

if [ -z "${REMAINING_ARGS[0]:-}" ]; then
    echo "Usage: test [--no-confinement] <test_conformance/path> [args...]"
    echo ""
    echo "  --no-confinement  Skip snap-bundled GPU/OpenCL drivers and use host"
    echo "                    drivers exclusively. Intended for use with the"
    echo "                    Checkbox framework when snap sandboxing is removed."
    exit 1
fi

ARCH="${SNAP_ARCH:-$(dpkg --print-architecture)}"
case "$ARCH" in
    amd64) ARCH_TRIPLE=x86_64-linux-gnu ;;
    arm64) ARCH_TRIPLE=aarch64-linux-gnu ;;
    *)     ARCH_TRIPLE="${ARCH}-linux-gnu" ;;
esac

if [ "$NO_CONFINEMENT" = "true" ]; then
    # Use host drivers exclusively.
    # LD_PRELOAD overrides DT_RPATH embedded by snapcraft's patchelf pass.
    # LD_LIBRARY_PATH covers the rest of the host driver stack.
    # Snap layout mounts are absent when Checkbox strips sandboxing, so
    # the host's /etc/OpenCL/vendors is used automatically.
    HOST_OCL="/usr/lib/${ARCH_TRIPLE}/libOpenCL.so.1"
    if [ ! -f "$HOST_OCL" ]; then
        echo "Error: --no-confinement requires the host OpenCL ICD loader at $HOST_OCL"
        echo "Install intel-opencl-icd (or equivalent) on the host before using this mode."
        exit 1
    fi
    export LD_PRELOAD="${HOST_OCL}"
    export LD_LIBRARY_PATH="/usr/lib/${ARCH_TRIPLE}:/usr/lib"
    echo "Host OpenCL ICD loader: ${HOST_OCL}"
else
    # Use whichever gpu content interface is connected (base-dependent).
    GPU_DIR=""
    for candidate in gpu-2604 gpu-2404; do
        if [ -d "${SNAP}/${candidate}" ]; then
            GPU_DIR="${SNAP}/${candidate}"
            break
        fi
    done
    if [ -n "$GPU_DIR" ]; then
        # Content-interface providers expose their libraries under different
        # subpaths depending on how the provider snap is built:
        #   - mesa-2404 shares its whole snap root, so libraries land at
        #     usr/lib/<triple> directly.
        #   - mesa-2604 shares a nested "mesa-2604/" subtree laid out the
        #     same way: mesa-2604/usr/lib/<triple>.
        #   - Vendor-shipped drivers (e.g. mediatek-genio-*-gpu-drivers,
        #     rz-gpu-snap-*) share a "graphics/" subtree laid out as lib/.
        # Probe every known layout and use whichever ones actually exist.
        LIB_DIRS=()
        for subpath in \
            "usr/lib/${ARCH_TRIPLE}" \
            "lib" \
            "mesa-2404/usr/lib/${ARCH_TRIPLE}" \
            "mesa-2604/usr/lib/${ARCH_TRIPLE}"
        do
            if [ -d "${GPU_DIR}/${subpath}" ]; then
                LIB_DIRS+=("${GPU_DIR}/${subpath}")
            fi
        done
        if [ ${#LIB_DIRS[@]} -eq 0 ]; then
            echo "Error: no GPU library directory found under ${GPU_DIR}"
            exit 1
        fi
        NEW_LIBRARY_PATH="$(IFS=:; echo "${LIB_DIRS[*]}")"
        export LD_LIBRARY_PATH="${NEW_LIBRARY_PATH}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

        # The content interface only shares the vendor's shared libraries,
        # not an ICD registration file, so the bundled ocl-icd loader has no
        # vendor entry to query (/etc/OpenCL/vendors inside this snap is
        # empty). Detect known vendor OpenCL implementation libraries and
        # register them dynamically via OCL_ICD_VENDORS, an ocl-icd loader
        # feature that overrides the vendor directory it scans. Some vendor
        # packages ship the ICD entry points (clIcdGetPlatformIDsKHR) in
        # libOpenCL.so rather than in libmali.so (e.g. rz-gpu-snap), so a
        # single .icd file is written per candidate found instead of
        # stopping at the first match: the loader silently skips any file
        # whose target turns out not to be ICD-compliant.
        ICD_VENDOR_DIR="/tmp/opencl-cts-icd-vendors-$(id -u)"
        rm -f "${ICD_VENDOR_DIR}"/*.icd 2>/dev/null
        icd_count=0
        SEEN_TARGETS=""
        for dir in "${LIB_DIRS[@]}"; do
            for vendor_lib in libOpenCL.so libmali.so; do
                if [ -f "${dir}/${vendor_lib}" ]; then
                    # Multiple candidate names can be symlinks to the same
                    # physical driver blob (e.g. libOpenCL.so and libmali.so
                    # both resolving to libmali.so.0.48.0). Registering the
                    # same target twice makes the ICD loader report the same
                    # GPU as two duplicate platforms, so dedupe by real path.
                    real_target="$(readlink -f "${dir}/${vendor_lib}")"
                    case " ${SEEN_TARGETS} " in
                        *" ${real_target} "*)
                            continue
                            ;;
                    esac
                    SEEN_TARGETS="${SEEN_TARGETS} ${real_target}"
                    mkdir -p "${ICD_VENDOR_DIR}"
                    echo "${vendor_lib}" > "${ICD_VENDOR_DIR}/vendor-${icd_count}.icd"
                    icd_count=$((icd_count + 1))
                fi
            done
        done
        if [ "$icd_count" -gt 0 ]; then
            export OCL_ICD_VENDORS="${ICD_VENDOR_DIR}"
        fi
    else
        echo "Error: gpu content interface not found at ${SNAP}/gpu-2404 or ${SNAP}/gpu-2604"
        echo "Connect it with one of:"
        echo "  snap connect opencl-cts:gpu-2404 mesa-2404:gpu-2404   # core24"
        echo "  snap connect opencl-cts:gpu-2604 mesa-2604:gpu-2604   # core26"
        exit 1
    fi
fi

TEST_BIN="${SNAP}/usr/bin/test_conformance/${REMAINING_ARGS[0]}"
TEST_DIR="$(dirname "$TEST_BIN")"
TEST_NAME="$(basename "$TEST_BIN")"

cd "$TEST_DIR"
exec "./$TEST_NAME" "${REMAINING_ARGS[@]:1}"
